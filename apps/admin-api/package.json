{
  "name": "@yulona/admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "openapi:export": "bun scripts/export-openapi.ts",
    "seed": "bun --env-file=../../.env --env-file=.env scripts/seed-admin.ts"
  },
  "dependencies": {
    "@yulona/ai-runtime": "workspace:*",
    "@yulona/crypto": "workspace:*",
    "@yulona/db": "workspace:*",
    "@yulona/providers": "workspace:*",
    "@yulona/shared": "workspace:*",
    "hono": "^4.6.0",
    "postgres": "^3.4.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
