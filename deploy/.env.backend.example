# =================================================================================================
# Lumi backend on a VM, frontends on Vercel ("split deployment").
# Copy to /opt/yulona/deploy/.env on the VM (chmod 600) and fill it in. deploy/setup.sh can generate the secrets
# for you; every value below is a placeholder. This file never leaves the VM: do NOT put these values in GitHub
# secrets or in the repository. deploy/.env.example documents every variable, this file lists what a split
# deployment needs and why.
#
# Recommended hostnames (all under ONE registrable domain, so cookies work between the Vercel apps and the VM):
#   app.example.com        tenant dashboard   (Vercel project, Root Directory apps/dashboard)
#   admin.example.com      platform admin web (Vercel project, Root Directory apps/admin-web)
#   api.example.com        API + worker       (this VM, Caddy)
#   admin-api.example.com  admin API          (this VM, Caddy, optional)
# Using *.vercel.app for the web apps and a custom domain for the API makes the browser treat them as different
# sites: the admin API refresh cookie is SameSite=Strict and will not be sent, so admins would be signed out on
# every reload. Use custom domains under the same parent domain.
# =================================================================================================

# ---- Required: generated secrets (openssl rand -base64 32). Never change ENCRYPTION_KEY after data exists.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Behind your own reverse proxy (nginx etc.) on a private VM: no ports 80/443 on this VM.
# Your proxy terminates TLS for api.example.com and admin-api.example.com and forwards both to this address, keeping
# the Host header and sending X-Forwarded-For. Caddy stays inside the VM only to switch traffic during rollouts.
CADDYFILE=Caddyfile.proxied
# The VM's PRIVATE address (not 0.0.0.0) and the port your proxy forwards to.
PROXY_BIND=10.0.0.5
HTTP_PORT=8080
HTTPS_PORT=8443
# Your proxy's address(es), space separated.
PROXY_TRUSTED_CIDRS=10.0.0.4/32
# SITE_ADDRESS below is only a host name label here (no certificate is requested).

# ---- Required: where things live
# Host Caddy serves the API on (DNS A/AAAA record to this VM; Caddy gets the TLS certificate automatically).
SITE_ADDRESS=api.example.com
# Public API origin, no trailing slash. Used for OAuth callbacks (Calendly, Google), webhooks and widget links.
PUBLIC_API_URL=https://api.example.com
# Tenant dashboard origin (the Vercel project). Used for email links and OAuth return redirects.
APP_URL=https://app.example.com
# Browsers allowed to call the API: the dashboard origin(s), comma separated. Add each Vercel preview origin
# you actually test with; never use a wildcard.
CORS_ORIGINS=https://app.example.com
# Where the widget script is served from (it ships with the dashboard on Vercel).
WIDGET_SCRIPT_URL=https://app.example.com/widget.js
# true ONLY if the dashboard and the API are on different registrable domains (cookie SameSite=None; Secure).
CROSS_SITE_COOKIES=false
# saas = hosted product (credits, billing, Stripe). selfhosted = customer-run, uncharged.
DEPLOYMENT_MODE=saas
# Open sign-ups on the dashboard (true for the public product, false for invite-only).
ALLOW_PUBLIC_SIGNUP=true
LOG_LEVEL=info
# Leave off in production; if you enable the API reference at /docs, set a password.
OPENAPI_ENABLED=false

# ---- AI provider (platform-managed in SaaS). Any OpenAI-compatible service: see AI_* in deploy/.env.example.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: cheaper model for the Ask Lumi copilot.
COPILOT_MODEL=

# ---- Email (invitations, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lumi <no-reply@example.com>"

# ---- Optional integrations (leave empty to disable)
# Google Calendar. Redirect URI: ${PUBLIC_API_URL}/api/v1/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Calendly. Register EXACTLY ${PUBLIC_API_URL}/api/v1/calendar/calendly/callback in the Calendly app (https in production).
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
# Stripe (SaaS). Webhook endpoint: ${PUBLIC_API_URL}/api/v1/webhooks/billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Virus scanning of uploads (enable COMPOSE_PROFILES=clamav in the full stack).
CLAMAV_URL=

# =================================================================================================
# Platform admin (separate service, optional). Deployed independently by deploy/rollout-admin-api.sh.
# =================================================================================================
# >= 32 chars (openssl rand -base64 48). MUST differ from JWT_SECRET, otherwise the admin API refuses to start.
ADMIN_JWT_SECRET=
# Password of the DB login role yulona_admin (EXECUTE on sa_* functions only). URL-safe characters only.
ADMIN_DB_PASSWORD=
# The one browser origin allowed to call the admin API: the admin web on Vercel.
ADMIN_WEB_ORIGIN=https://admin.example.com
# Host Caddy serves the admin API on (see deploy/admin-site/admin-api-only.caddy.example).
ADMIN_SITE_ADDRESS=admin-api.example.com
# Dashboard URL used for "Impersonate" links (defaults to APP_URL).
ADMIN_CUSTOMER_APP_URL=https://app.example.com
# Optional: office/VPN CIDRs allowed to reach the admin API, comma separated. Empty = any IP (login still required).
ADMIN_ALLOWED_CIDRS=
# false for now. Set true to force every admin to enrol an authenticator app.
ADMIN_REQUIRE_2FA=false
# Do not set COMPOSE_PROFILES here: deploy/rollout-admin-api.sh activates the admin profile for the admin-api
# container itself, and api/worker rollouts never start it.

# =================================================================================================
# Vercel project environment variables (set in the Vercel dashboard, NOT here):
#   tenant dashboard (apps/dashboard):  VITE_API_URL=https://api.example.com
#   admin web (apps/admin-web):         VITE_ADMIN_API_URL=https://admin-api.example.com
# GitHub repository settings (Settings > Secrets and variables > Actions):
#   Variable BACKEND_DEPLOY_ENABLED=true   turn on automatic backend deploys once the VM and runner exist
#   (no secrets are needed: the workflow uses the built-in GITHUB_TOKEN and the runner on the VM)
# =================================================================================================
