# Lumi production configuration. deploy/setup.sh copies this to deploy/.env and fills every CHANGE_ME with
# random values (chmod 600). Never commit deploy/.env. Passwords must be URL-safe (hex/alphanumeric)
# because they are embedded in connection URLs. Every variable the stack reads is listed here.

# =================================================================================================
# Public address
# =================================================================================================
# Domain for automatic HTTPS (e.g. app.example.com). `localhost` = local test CA. `:80` = plain HTTP.
SITE_ADDRESS=localhost
# Canonical public URL of the dashboard (used in emails/links). Default: https://$SITE_ADDRESS.
# APP_URL=https://app.example.com
# Public base URL of the API as seen by widgets (default: same origin as the dashboard). Split deployments only.
# PUBLIC_API_URL=
# URL of the widget bundle embedded on customer sites. Default /widget.js (served by the dashboard image).
# Pin a release with /widget.<hash>.js (hash in /widget.version).
# WIDGET_SCRIPT_URL=/widget.js

# =================================================================================================
# Secrets (generated by setup.sh)
# =================================================================================================
# Owner of the database; used only by the one-shot `migrate` / `create-tenant` services.
POSTGRES_PASSWORD=CHANGE_ME
# Runtime DB role `yulona_app` (no BYPASSRLS) used by api/worker. Applied by setup.sh at first DB init.
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# HS256 signing key for access tokens. >= 32 bytes. Rotating it logs everyone out.
JWT_SECRET=CHANGE_ME
# AES-256 master key (base64, 32 bytes) for channel credentials, webhook secrets, OAuth tokens.
# LOSING OR CHANGING IT makes stored credentials unreadable: back it up with this file.
ENCRYPTION_KEY=CHANGE_ME

# =================================================================================================
# Deployment mode / behaviour
# =================================================================================================
# selfhosted (default here): one tenant, no billing routes, public signup always closed.
# saas: multi-tenant with billing (ALLOW_PUBLIC_SIGNUP honoured). Platform administration is a separate service (see "Platform admin").
DEPLOYMENT_MODE=selfhosted
# Only honoured when DEPLOYMENT_MODE=saas.
ALLOW_PUBLIC_SIGNUP=false
# Comma-separated origins allowed to call the API cross-origin (split deploy). Empty = same-origin only.
CORS_ORIGINS=
# true only when dashboard and api are on different SITES (sets refresh cookie SameSite=None; Secure).
CROSS_SITE_COOKIES=false
# API URL given to the dashboard at container start. Empty = same-origin /api (default with Caddy).
DASHBOARD_API_URL=
LOG_LEVEL=info
# Publish the Scalar reference at /docs. Off by default. DOCS_PASSWORD is HTTP basic auth
# (username DOCS_USERNAME, default "docs") and is required when OPENAPI_ENABLED=true.
# OPENAPI_ENABLED=false
# DOCS_USERNAME=docs
# DOCS_PASSWORD=CHANGE_ME

# =================================================================================================
# AI provider
# =================================================================================================
# openai (any OpenAI-compatible endpoint), deepseek or mock (offline canned answers; for demos/tests only).
# Empty = openai when AI_API_KEY is set, otherwise mock.
AI_PROVIDER=
AI_API_KEY=
# Base URL for OpenAI-compatible servers (Azure, vLLM, Ollama...). Empty = api.openai.com.
AI_BASE_URL=
AI_MODEL=
# Any OpenAI-compatible service: header carrying the key (default Authorization), scheme bearer|raw|none
# (raw = send the key as-is, e.g. AI_AUTH_HEADER=api-key AI_AUTH_SCHEME=raw for Azure), extra headers and
# query string as JSON objects (e.g. AI_QUERY={"api-version":"2024-06-01"}), and the chat path (default /chat/completions).
AI_AUTH_HEADER=
AI_AUTH_SCHEME=
AI_EXTRA_HEADERS=
AI_QUERY=
AI_CHAT_PATH=
# Per-message token cost controls (all optional; defaults shown). Tool rounds the model may use before a forced
# tool-free answer, token budget per message, knowledge sizes and history length. Lower = cheaper, higher = more context.
# AI_MAX_TOOL_ROUNDS=2
# AI_TURN_TOKEN_BUDGET=12000
# AI_INLINE_ALL_CHARS=4000
# AI_PRELOAD_SECTIONS=2
# AI_READ_SKILL_MAX_CHARS=3000
# AI_SEARCH_SNIPPET_CHARS=160
# AI_STALE_TOOL_RESULT_CHARS=300
# AI_HISTORY_MESSAGES=6
# AI_HISTORY_MESSAGE_CHARS=600
# AI_MAX_OUTPUT_TOKENS=700
# Only for OpenAI-compatible models that support it (sent as reasoning_effort): none, minimal, low, medium, high.
# AI_REASONING_EFFORT=
# Optional: model for the Ask Lumi assistant (a cheaper model than the chat model is fine). Empty = provider default.
COPILOT_MODEL=
# SaaS only: message customers see when the workspace's AI credits are used up (default text if empty).
CREDITS_EXHAUSTED_MESSAGE=
# Agent knowledge needs no embedding model: sources become "skills" (titled sections) the agent reads and searches.

# =================================================================================================
# Email (SMTP). Empty SMTP_HOST = emails are only logged to the console.
# =================================================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

# =================================================================================================
# Object storage (knowledge files, exports). Empty S3_BUCKET = in-memory (NOT durable: dev only).
# =================================================================================================
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bundled MinIO (enable with COMPOSE_PROFILES=minio, then point S3_* at it:
#   S3_ENDPOINT=http://minio:9000  S3_BUCKET=yulona  S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=$MINIO_ROOT_USER  S3_SECRET_ACCESS_KEY=$MINIO_ROOT_PASSWORD)
MINIO_ROOT_USER=yulona
MINIO_ROOT_PASSWORD=CHANGE_ME

# =================================================================================================
# Integrations (all optional)
# =================================================================================================
# Google Calendar bookings (OAuth). Redirect: https://<SITE_ADDRESS>/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Calendly bookings (OAuth "Connect Calendly"). Create the OAuth app at developer.calendly.com (web app, PKCE; scopes users:read,
# event_types:read, availability:read, scheduled_events:write, scheduling_links:write). Redirect (default): <PUBLIC_API_URL>/api/v1/calendar/calendly/callback
# Register EXACTLY that URL in the Calendly app (Settings > Connectors shows it with a Copy button). Production apps need https; only a Sandbox
# app accepts http://localhost. Set PUBLIC_API_URL, otherwise the URI falls back to localhost and Calendly connect is refused in production.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
# Stripe is only used in DEPLOYMENT_MODE=saas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price id of the $49/month Pro plan (test mode: run scripts/stripe-sandbox.sh, it prints this line). Any plan works as
# STRIPE_PRICE_<PLAN> (plan key in upper case). Webhook endpoint: POST <PUBLIC_API_URL>/api/v1/webhooks/billing
STRIPE_PRICE_PRO=
# Virus scanning of uploads: enable COMPOSE_PROFILES=clamav and set CLAMAV_URL=http://clamav:3000 (or tcp://host:3310 for your own clamd)
CLAMAV_URL=

# =================================================================================================
# Platform admin (optional, SaaS operators). Separate service + host: COMPOSE_PROFILES=admin, see docs "Platform admin".
# Not part of the self-hosted bundle; leave all of these unset unless you run the admin profile.
# =================================================================================================
# Own signing key for admin tokens (>= 32 chars, `openssl rand -base64 48`). MUST differ from JWT_SECRET (startup aborts otherwise).
# ADMIN_JWT_SECRET=
# Password of the DB login role `yulona_admin` (EXECUTE on sa_* functions only, no table grants). Applied by the migrate service.
# ADMIN_DB_PASSWORD=
# Optional full admin DB URL instead of DATABASE_URL host + ADMIN_DB_PASSWORD.
# ADMIN_DB_URL=
# Exactly one allowed browser origin (https), e.g. https://admin.example.com
# ADMIN_WEB_ORIGIN=
# Host Caddy serves the admin site on (see deploy/admin-site/admin.caddy.example)
# ADMIN_SITE_ADDRESS=admin.example.com
# Optional comma-separated IPv4/IPv6 CIDRs allowed to reach the admin API (empty = any)
# ADMIN_ALLOWED_CIDRS=
# true = every admin must enrol TOTP (restricted session until they do). Default false.
# ADMIN_REQUIRE_2FA=false
# Customer dashboard URL used for impersonation links (default APP_URL)
# ADMIN_CUSTOMER_APP_URL=
# Per-admin rate limits per minute (reads / writes)
# ADMIN_RATE_READ=30
# ADMIN_RATE_WRITE=10
# Admin session (refresh cookie) lifetime in days
# ADMIN_SESSION_TTL_DAYS=7
# API URL given to the admin-web container at start. Empty = same origin (default behind the Caddy admin site, which proxies /api to admin-api).
# ADMIN_WEB_API_URL=

# =================================================================================================
# License (offline verification, no phone-home). See docs/self-hosting.md.
# =================================================================================================
LICENSE_KEY=
# PEM of the vendor public key (use \n for newlines).
LICENSE_PUBLIC_KEY=

# =================================================================================================
# Compose
# =================================================================================================
# Optional services, comma-separated: minio, clamav
# COMPOSE_PROFILES=minio,clamav
# Images (optional). Defaults build locally from this repo; set registry images (pinned tags/digests) to skip building.
# deploy/rollout.sh sets YULONA_API_IMAGE for each blue/green swap (see apps/docs self-hosting upgrade page).
# YULONA_API_IMAGE=ghcr.io/your-org/yulona/api:main
# YULONA_DASHBOARD_IMAGE=ghcr.io/your-org/yulona/dashboard:main
# YULONA_ADMIN_API_IMAGE=ghcr.io/your-org/yulona/admin-api:main
# YULONA_ADMIN_WEB_IMAGE=ghcr.io/your-org/yulona/admin-web:main
